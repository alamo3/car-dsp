<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): credentials never leave the phone, neither to the
     cloud backup nor to a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cabin_eq_secrets.xml" />
        <!-- Downloaded audio is large and re-downloadable; the list of downloads is kept. -->
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cabin_eq_secrets.xml" />
        <!-- Downloaded audio is large and re-downloadable; the list of downloads is kept. -->
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
