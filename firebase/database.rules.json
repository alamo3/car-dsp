{
  "rules": {
    "jam": {
      "$sid": {
        ".validate": "$sid.length <= 64",
        "info": {
          ".read": true,
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "!newData.exists() || newData.hasChildren(['createdAt'])"
        },
        "state": {
          ".read": true,
          ".write": true,
          ".validate": "!newData.exists() || newData.hasChildren(['playing', 'updatedAt'])"
        },
        "ops": {
          ".read": true,
          "$op": {
            ".write": "!data.exists() || !newData.exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['op', 'guest', 'at']) && newData.child('op').isString() && newData.child('op').val().matches(/^(add|move|remove|vote|skip|search)$/) && newData.child('guest').isString() && newData.child('guest').val().length <= 64 && newData.child('at').isNumber())",
            "op": {
              ".validate": true
            },
            "guest": {
              ".validate": true
            },
            "at": {
              ".validate": true
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "q": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "reqId": {
              ".validate": "(newData.isString() && newData.val().length <= 40) || newData.isNumber()"
            },
            "key": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "to": {
              ".validate": "newData.isNumber()"
            },
            "track": {
              "$f": {
                ".validate": "$f.length <= 16 && ((newData.isString() && newData.val().length <= 1000) || newData.isNumber() || newData.isBoolean())"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "results": {
          ".read": true,
          "$req": {
            ".write": "!data.exists() || !newData.exists()",
            ".validate": "!newData.exists() || ($req.length <= 40 && newData.hasChildren(['at', 'items']))"
          }
        },
        "guests": {
          ".read": true,
          "$g": {
            ".write": "!newData.exists()"
          }
        }
      }
    },
    "diag": {
      "$id": {
        ".validate": "$id.length >= 16 && $id.length <= 64 && $id.matches(/^[A-Za-z0-9_-]+$/)",
        ".read": true,
        "meta": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.hasChildren(['version', 'updatedAt']) && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 300000)",
          "$f": {
            ".validate": "$f.matches(/^(version|device|android|engine|endless|progressive|floatDecoding|updatedAt)$/) && ((newData.isString() && newData.val().length <= 100) || newData.isNumber() || newData.isBoolean())"
          }
        },
        "events": {
          ".write": "!newData.exists()",
          "$e": {
            ".write": "!data.exists() || !newData.exists()",
            ".validate": "!newData.exists() || ($e.matches(/^[0-9]{13}-[0-9]{3}$/) && newData.hasChildren(['at', 'l', 't', 'm']))",
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= now - 1209600000"
            },
            "l": {
              ".validate": "newData.isString() && newData.val().matches(/^[DIWE]$/)"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "m": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
